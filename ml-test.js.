
const MODEL_URL =
  "./models/train_v2_efficientnet_b0_softdelta_w0.50_float16.tflite";

let modelPromise = null;

export async function testModel() {
  const status = document.getElementById("ml-status");
  const button = document.getElementById("ml-test-button");

  const setStatus = (message) => {
    if (status) status.textContent = message;
  };

  if (!window.tf || !window.tflite) {
    setStatus("ML runtime did not load. Check your internet connection.");
    return;
  }

  if (button) button.disabled = true;

  let input = null;
  let outputs = null;

  try {
    setStatus("Loading model...");

    if (!modelPromise) {
      window.tflite.setWasmPath(
        "https://cdn.jsdelivr.net/npm/@tensorflow/tfjs-tflite@0.0.1-alpha.10/dist/"
      );

      modelPromise = window.tflite.loadTFLiteModel(MODEL_URL);
    }

    const model = await modelPromise;

    setStatus("Model loaded. Running test...");

    input = window.tf.zeros([1, 512, 256, 3], "float32");
    outputs = model.predict(input);

    const tensors = Array.isArray(outputs)
      ? outputs
      : outputs && outputs.shape
        ? [outputs]
        : Object.values(outputs || {});

    const descriptions = tensors.map((tensor, index) => {
      const shape = tensor && tensor.shape
        ? tensor.shape.join(" × ")
        : "unknown shape";

      return `Output ${index + 1}: ${shape}`;
    });

    setStatus(
      "Model inference ran on dummy input. " +
      descriptions.join("; ") +
      ". Live camera detection is not connected or verified."
    );
  } catch (error) {
    console.error("ML model test failed:", error);
    modelPromise = null;

    setStatus(
      "ML test failed: " +
      (error?.message || String(error))
    );
  } finally {
    if (input) input.dispose();

    if (outputs) {
      const tensors = Array.isArray(outputs)
        ? outputs
        : outputs && outputs.shape
          ? [outputs]
          : Object.values(outputs || {});

      tensors.forEach((tensor) => {
        if (tensor && typeof tensor.dispose === "function") {
          tensor.dispose();
        }
      });
    }

    if (button) button.disabled = false;
  }
}
