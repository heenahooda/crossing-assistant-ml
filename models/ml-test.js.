
import * as tf from "https://esm.sh/@tensorflow/tfjs";
import * as tflite from "https://esm.sh/@tensorflow/tfjs-tflite";

const MODEL_URL =
  "https://heenahooda.github.io/crossing-assistant-ml/models/train_v2_efficientnet_b0_softdelta_w0.50_float16.tflite";

export async function testModel() {
  const status = document.getElementById("ml-status");

  try {
    status.textContent = "Loading on-device ML runtime…";

    await tf.ready();

    status.textContent = "Loading model…";
    const model = await tflite.loadTFLiteModel(MODEL_URL);

    // Test the model with a zero-filled input of the required shape.
    // This tests execution only; it is NOT a real camera prediction.
    const input = tf.zeros([1, 512, 256, 3]);

    status.textContent = "Testing model execution…";
    const outputs = model.predict(input);

    const tensors = Array.isArray(outputs) ? outputs : [outputs];
    const details = [];

    for (let i = 0; i < tensors.length; i++) {
      const tensor = tensors[i];
      details.push({
        output: i,
        shape: tensor.shape,
        sample: Array.from(await tensor.data()).slice(0, 5)
      });
    }

    console.log("Model output details:", details);
    status.textContent =
      "Model executed. Check the browser console for output details.";

    input.dispose();
    tensors.forEach(tensor => tensor.dispose());
    model.dispose();

  } catch (error) {
    console.error("ML test failed:", error);
    status.textContent =
      "ML test failed: " + (error.message || String(error));
  }
}
